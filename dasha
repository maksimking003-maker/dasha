<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>С днём рождения 💝</title>
<script src="https://cdn.jsdelivr.net/npm/function-plot@1.24.4/dist/function-plot.js"></script>
<style>
  body { font-family: sans-serif; text-align: center; background:#fff5f8; margin:0; padding:20px; }
  h1 { color:#e91e63; }
  input { width:60px; padding:6px; margin:4px; border-radius:6px; border:1px solid #e91e63; }
  #plot { width:100%; max-width:700px; margin:0 auto; }
  .hint { color:#888; font-size:14px; }
</style>
</head>
<body>
  <h1>Введи коэффициенты — и увидишь сюрприз 🎂</h1>

  <div>
    y = <input id="a" value="1"> x² +
        <input id="b" value="0"> x +
        <input id="c" value="0">
  </div>

  <div id="plot"></div>
  <p class="hint">Подсказка: попробуй a = -1, b = 0, c = 3 😉</p>

  <script>
    const inputs = ['a','b','c'].map(id => document.getElementById(id));

    function draw() {
      const [a,b,c] = inputs.map(i => parseFloat(i.value) || 0);
      functionPlot({
        target: '#plot',
        width: 700, height: 500,
        grid: true,
        xAxis: { domain: [-8, 8] },
        yAxis: { domain: [-8, 8] },
        data: [
          // твоя парабола
          { fn: `${a}*x^2 + ${b}*x + ${c}`, color: '#2196f3' },
          // сердечко (неявная функция)
          { fn: '(x^2+y^2-1)^3 - x^2*y^3 = 0', color: '#e91e63', graphType: 'implicit' }
        ]
      });
    }

    inputs.forEach(i => i.addEventListener('input', draw));
    draw();
  </script>
</body>
</html>
