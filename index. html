<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>С днём рождения!</title>
<script src="https://cdn.jsdelivr.net/npm/function-plot@1.24.4/dist/function-plot.js"></script>
<style>
  body { font-family: sans-serif; text-align: center; background:#fff5f8; margin:0; padding:20px; }
  h1 { color:#e91e63; font-size: 24px; }
  input { width:50px; padding:5px; margin:2px; border-radius:6px; border:1px solid #e91e63; text-align: center;}
  #plot { width:100%; max-width:600px; margin: 20px auto; }
</style>
</head>
<body>
  <h1>Введи коэффициенты 🎂</h1>
  <div>
    y = <input id="a" value="1"> x² +
        <input id="b" value="0"> x +
        <input id="c" value="0">
  </div>
  <div id="plot"></div>
  
  <script>
    const inputs = ['a','b','c'].map(id => document.getElementById(id));
    function draw() {
      const [a,b,c] = inputs.map(i => parseFloat(i.value) || 0);
      functionPlot({
        target: '#plot',
        width: window.innerWidth > 600 ? 600 : window.innerWidth - 40,
        height: 400,
        grid: true,
        xAxis: { domain: [-8, 8] },
        yAxis: { domain: [-8, 8] },
        data: [
          { fn: `${a}*x^2 + ${b}*x + ${c}`, color: '#2196f3' },
          { fn: '(x^2+y^2-1)^3 - x^2*y^3 = 0', color: '#e91e63', graphType: 'implicit' }
        ]
      });
    }
    inputs.forEach(i => i.addEventListener('input', draw));
    draw();
  </script>
</body>
</html>
